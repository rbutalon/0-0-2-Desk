# Copy this file to .env and fill in your Supabase project credentials.
# Find both values in Supabase Dashboard -> Project Settings -> API.
#
# If these are left unset, DinkDesk automatically falls back to storing
# data in the browser's LocalStorage so the app is still fully usable
# during local development or a quick demo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
